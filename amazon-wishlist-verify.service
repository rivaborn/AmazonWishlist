# Amazon Wishlist live-deal verifier (scripts/verify_deals.py) run INSIDE the
# `wlvpn` NordVPN/WireGuard namespace so ONLY its Amazon price reads egress
# through NordVPN. The rest of the box (SSH, LAN, the wishlist scraper itself)
# is unaffected.
#
# The tunnel comes from VPNManager (github.com/rivaborn/VPNManager, since
# 2026-09-29): lease `wishlist` = netns wlvpn / iface wlwg, unit
# vpnmgr-tunnel@wishlist.service (on demand: StopWhenUnneeded, so it and its
# NordVPN slot go away when nothing needs it). This unit places the verifier in that
# namespace at start and binds the namespace's Nord DNS over /etc/resolv.conf
# (systemd does not apply the /etc/netns convention itself). BindsTo= the
# tunnel unit so the verifier stops too if the tunnel stops; Requires= brings
# the tunnel up. This unit deliberately does NOT tear the tunnel down itself:
# it is BindsTo/Requires the tunnel, so a systemctl stop of the tunnel from
# this unit's own ExecStopPost would propagate a stop back onto the
# already-stopping verifier and circular-wait against TimeoutStopSec (the
# recurring ~180s teardown deadlock that marked every daily run failed).
# Teardown is owned by the daily amazon-wishlist-bookbub.service ExecStopPost
# (not itself bound to the tunnel, so its stop cannot deadlock); a standalone
# run is torn down by StopWhenUnneeded (or an explicit `sudo systemctl stop
# vpnmgr-tunnel@wishlist.service`).
#
# This unit doubles as the daily re-verify step of the BookBub updater: the
# daily fetch runs OUTSIDE the netns (headful Chromium cannot launch inside a
# netns), and bookbub_daily starts THIS unit (--recheck) to run the Amazon
# re-check headless inside the namespace. There is NO Restart= and no
# [Install]: one run per trigger, and it is never enabled at boot — only the
# once-a-day scheduler/manual start triggers it, so a restart never runs it.
#
# The NordVPN session is negotiated by VPNManager (which owns every host
# `nordvpn connect` on the box) — this unit needs NO NordVPN credentials and stores
# none. Rotation is the app's call: verify_deals asks `sudo -n vpnmgr rotate
# wishlist --json` (scoped sudoers from VPNManager), which swaps the session IN
# PLACE, so this already-running verifier continues on the new exit.
# Per-host settings (DEALS_DB, VERIFY_*, WISHLIST_VPN_*) go in
# /etc/default/amazon-wishlist; install_systemd.sh reinstalls this unit from
# the repo on every deploy, so a hand-edit here is reverted. (If you override
# WISHLIST_VPN_NS away from the default `wlvpn`, update this unit's
# NetworkNamespacePath/BindReadOnlyPaths and the --netns argument too.)
#
# Run the full re-check:  sudo systemctl start amazon-wishlist-verify.service
# Follow progress:        journalctl -u amazon-wishlist-verify -f
# A finished pass is a fast no-op re-run (verified rows are skipped — the
# resume cursor is deal_status in DEALS_DB, not any file).

[Unit]
Description=Amazon Wishlist live-deal verifier (via wlvpn VPN namespace)
After=vpnmgr-tunnel@wishlist.service
Requires=vpnmgr-tunnel@wishlist.service
BindsTo=vpnmgr-tunnel@wishlist.service

[Service]
User=wishlist
Group=wishlist
WorkingDirectory=/opt/amazon-wishlist
# Run inside the VPN namespace; bind its Nord DNS over /etc/resolv.conf.
NetworkNamespacePath=/var/run/netns/wlvpn
BindReadOnlyPaths=/etc/netns/wlvpn/resolv.conf:/etc/resolv.conf
# Headless Chromium (the price reader) needs the same browser/home environment
# as the app unit — the browser lives only under /opt/amazon-wishlist.
Environment="HOME=/opt/amazon-wishlist"
Environment="XDG_RUNTIME_DIR=/tmp/runtime-wishlist"
Environment="PLAYWRIGHT_BROWSERS_PATH=/opt/amazon-wishlist/.cache/playwright"
Environment="PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64"
# Per-host overrides (DEALS_DB, VERIFY_*, WISHLIST_VPN_*). Optional: the
# leading `-` means an install that keeps the defaults needs no such file.
EnvironmentFile=-/etc/default/amazon-wishlist
ExecStart=/opt/amazon-wishlist/.venv/bin/python scripts/verify_deals.py --netns wlvpn --recheck
# No ExecStopPost teardown here on purpose: this unit is BindsTo/Requires the
# tunnel, so stopping the tunnel from its own stop-post circular-waits against
# TimeoutStopSec (see header). The daily bookbub unit's ExecStopPost owns
# teardown; after a standalone run StopWhenUnneeded stops the tunnel unit.
# No Restart= (one run per trigger — the app's once-a-day schedule is the
# retry; a failure must die, not flap the tunnel on a restart loop). No
# [Install] section: never enabled at boot.
# Hardening (mirrors amazon-wishlist.service: chromium's multi-process model —
# zygote / crashpad / shared /tmp sockets — breaks under stricter settings;
# see the NOTE in that unit). NoNewPrivileges is deliberately NOT set.
ProtectSystem=false
PrivateTmp=false
ReadWritePaths=/opt/amazon-wishlist/data /opt/amazon-wishlist/.cache
