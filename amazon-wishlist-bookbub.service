# Amazon Wishlist daily BookBub deal updater (scripts/bookbub_daily.py). The
# FETCH runs OUTSIDE the `wlvpn` namespace — headful Chromium (which the fetch
# uses to clear the Cloudflare challenge) cannot launch inside a netns, and the
# fetch needs neither the tunnel nor the netns. ONLY the re-verify pass's
# Amazon price reads egress through NordVPN, via amazon-wishlist-verify.service
# (started by bookbub_daily at the end of the run) — the same fail-closed
# guarantee as before, just split across the two units.
#
# Triggered by the APP's scheduler (app/scheduler.py, at the BookBub time set
# in the Settings tab), which runs:
#   sudo -n systemctl start amazon-wishlist-bookbub.service
# via the scoped sudoers rule scripts/install_systemd.sh provisions. The old
# amazon-wishlist-bookbub.timer (18:00) is retired — the app schedules the run.
# Follow progress: journalctl -u amazon-wishlist-bookbub -f
#
# What one run does:
#   1. fetch today's BookBub daily deals (BOOKBUB_USERNAME / BOOKBUB_PASSWORD
#      from /etc/default/amazon-wishlist; Playwright clears Cloudflare, headless
#      then headed under Xvfb), upserts them into DEALS_DB, and refreshes
#      owned_in_grimmory + dedups (owned books are hidden from the tab), then
#   2. starts amazon-wishlist-verify.service, which re-verifies every
#      NON-EXPIRED deal against live Amazon prices, headless INSIDE the wlvpn
#      namespace (expired deals are never re-checked); newly current deals flow
#      into the BookBub Deals tab automatically.

[Unit]
Description=Amazon Wishlist daily BookBub deal updater (fetch on host; re-verify via the netns verify unit)
After=amazon-wishlist-verify.service

[Service]
Type=oneshot
User=wishlist
Group=wishlist
WorkingDirectory=/opt/amazon-wishlist
# Runs OUTSIDE the tunnel namespace on purpose: the BookBub fetch's headful
# fallback cannot launch inside the netns (headed Chromium crashes there with a
# crashpad SIGTRAP), and the fetch needs neither the tunnel nor the netns. The
# Amazon re-verify (step 2) runs headless INSIDE the netns via the
# amazon-wishlist-verify.service unit, which bookbub_daily starts and waits on.
# Headless Chromium (the price reader) needs the same browser/home environment
# as the app unit — the browser lives only under /opt/amazon-wishlist.
Environment="HOME=/opt/amazon-wishlist"
Environment="XDG_RUNTIME_DIR=/tmp/runtime-wishlist"
Environment="PLAYWRIGHT_BROWSERS_PATH=/opt/amazon-wishlist/.cache/playwright"
Environment="PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64"
# Per-host overrides (BOOKBUB_LOGIN_LINK, DEALS_DB, GRIMMORY_DB, VERIFY_*,
# WISHLIST_VPN_*). Optional: the leading `-` means an install that keeps the
# defaults needs no such file.
EnvironmentFile=-/etc/default/amazon-wishlist
# Run the whole cycle under a throwaway virtual display: the BookBub fetch's
# headful fallback (app/bookbub.py tries headless first, then a HEADED browser
# to clear Cloudflare more reliably) needs an X server, and this box is
# headless. xvfb-run -a starts an isolated Xvfb and tears it down when the run
# ends; the headless re-verify pass simply ignores the display.
ExecStart=/usr/bin/xvfb-run -a /opt/amazon-wishlist/.venv/bin/python scripts/bookbub_daily.py --netns wlvpn
# Teardown after EVERY run (success, failure, or crash): the VPN is in use only
# while the daily cycle is running ("when not in use, the VPN should not be
# connected"). ExecStopPost runs as the service user, hence the scoped sudoers
# rule (install_systemd.sh provisions it).
ExecStopPost=/usr/bin/sudo -n /usr/bin/systemctl stop amazon-wishlist-vpn.service
# One run per trigger, NO Restart=: the app's once-a-day schedule is the retry.
# A failing run must die (and let the VPN down) instead of flapping the tunnel
# on a 30 s restart loop all day.
# Hardening (mirrors amazon-wishlist.service: chromium's multi-process model —
# zygote / crashpad / shared /tmp sockets — breaks under stricter settings;
# see the NOTE in that unit). NoNewPrivileges is deliberately NOT set here:
# the ExecStopPost (and the verify-unit trigger in step 2) rely on the scoped
# `wishlist` sudoers rule, and NoNewPrivileges=true would silently block sudo.
ProtectSystem=false
PrivateTmp=false
ReadWritePaths=/opt/amazon-wishlist/data /opt/amazon-wishlist/.cache

[Install]
WantedBy=multi-user.target
