# Example .env for local development — copy to `.env` (gitignored) and fill in
# real values. NEVER commit the real `.env`. Every key here is optional; the
# app has sensible defaults for anything left out (see README » Configuration).
#
# Real environment variables always win over this file: on the Ubuntu host the
# app reads the SAME keys from `/etc/default/amazon-wishlist` (systemd
# EnvironmentFile), so production should keep using that — this `.env` is for
# local dev boxes and ad-hoc runs. Nothing here is required to run the app.
#
#   cp .env.example .env   # then edit .env
#
# Values with spaces or special characters should be quoted, e.g.
#   GRIMMORY_PASSWORD="my pass"
# `.env` is gitignored (`.gitignore` has `.env`); `.env.example` is committed.

# ---------- BookBub (daily ebook deals + credentials) ----------
# Real secrets (the account the daily updater logs in as). Never commit.
BOOKBUB_USERNAME=
BOOKBUB_PASSWORD=
# Optional ad-hoc login: the signed outbound link from the daily BookBub email.
BOOKBUB_LOGIN_LINK=

# ---------- Grimmory (owned-book catalog) ----------
# Real secrets for the one-off catalog build (app/grimmory.py). Never commit.
GRIMMORY_URL=http://192.168.1.13:6060/
GRIMMORY_USERNAME=
GRIMMORY_PASSWORD=
GRIMMORY_LIBRARIES=Amazon fksogbetun,Amazon rivaborn
GRIMMORY_DB=data/grimmory.db

# ---------- NordVPN (live-deal verifier exit-IP rotation) ----------
# Real secrets (the host-CLI path on dev boxes). Never commit.
NORDVPN_USERNAME=
NORDVPN_PASSWORD=
# The Ubuntu host uses the wlvpn netns tunnel instead (`WISHLIST_VPN_*` below) —
# neither NORDVPN_USERNAME/PASSWORD, nor NORDVPN_CLI, is needed there.
NORDVPN_CLI=nordvpn
NORDVPN_COUNTRIES=United States,Germany,Japan,United Kingdom,Canada,Australia
NORDVPN_ROTATE_EVERY=10

# ---------- wlvpn tunnel (Ubuntu deploy; set in /etc/default/amazon-wishlist) ----------
WISHLIST_VPN_USER=
WISHLIST_VPN_LAN_SUBNET=192.168.1.0/24
WISHLIST_VPN_NS=wlvpn
WISHLIST_VPN_IFACE=wlwg
WISHLIST_VPN_DNS=103.86.96.100,1.1.1.1
WISHLIST_VPN_UNIT=amazon-wishlist-vpn.service

# ---------- Mirror role (secondary pulls from the primary) ----------
# WISHLIST_ROLE=secondary        # default is primary
# WISHLIST_PRIMARY_URL=http://192.168.1.50:9060

# ---------- Optional local LLM normalisation (off by default) ----------
# LLM_BASE_URL=http://192.168.1.40:11430/v1
# LLM_MODEL=
# LLM_TIMEOUT=120

# ---------- Data locations (defaults are under data/, already gitignored) ----------
# WISHLIST_DB=data/wishlist.db
# DEALS_DB=data/deals.db
# DEALS_COVERS_DIR=data/covers
# GRIMMORY_DB=data/grimmory.db
