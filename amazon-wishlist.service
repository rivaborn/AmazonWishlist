[Unit]
Description=Amazon Wishlist Deal Tracker
After=network.target

[Service]
Type=simple
User=wishlist
Group=wishlist
WorkingDirectory=/opt/amazon-wishlist
Environment="WISHLIST_PORT=9060"
Environment="PLAYWRIGHT_BROWSERS_PATH=/opt/amazon-wishlist/.cache/playwright"
Environment="PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64"
Environment="HOME=/opt/amazon-wishlist"
Environment="XDG_RUNTIME_DIR=/tmp/runtime-wishlist"
# Per-host settings that must NOT live in the repo -- above all WISHLIST_ROLE.
# install_systemd.sh reinstalls this unit from the repo copy on every deploy, so
# anything hand-edited into the installed unit is silently reverted by the next
# `git pull && sudo bash scripts/install_systemd.sh`. The leading `-` makes the
# file optional, so a single-instance install needs no change at all.
EnvironmentFile=-/etc/default/amazon-wishlist
ExecStart=/opt/amazon-wishlist/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 9060
Restart=on-failure
RestartSec=5

# Hardening
# NOTE: chromium's multi-process model (zygote / crashpad / IPC sockets) is
# fragile under systemd PrivateTmp and ProtectHome. We do NOT set
# NoNewPrivileges: the app's scheduler needs the scoped `wishlist` sudoers rule
# (`sudo -n systemctl start amazon-wishlist-bookbub.service`) to fire the daily
# BookBub run, and NoNewPrivileges=true silently blocks sudo. We keep a
# softened ProtectSystem; PrivateTmp is dropped because chromium's child
# processes share /tmp socket paths the parent set up.
ProtectSystem=false
PrivateTmp=false
ReadWritePaths=/opt/amazon-wishlist/data /opt/amazon-wishlist/.cache

[Install]
WantedBy=multi-user.target
